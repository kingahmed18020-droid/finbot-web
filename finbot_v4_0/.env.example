# ══════════════════════════════════════════════════
#         finbot v4.1 — ملف إعدادات البيئة
# ══════════════════════════════════════════════════

# ── مطلوب ────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token
OWNER_CHAT_ID=your_telegram_chat_id

# ── بنك الإجابات ──────────────────────────────────
ANSWERS_FILE=answers.txt

# ── الأداء والتشغيل ──────────────────────────────
MAX_JOBS=2              # حسابات متوازية (2 للـ RAM المتوسط)
MAX_QUEUE=10            # أقصى منتظرين في الطابور
JOB_TIMEOUT_MIN=240     # أقصى مدة لكل حساب (دقائق)
RETRIES=2               # إعادة تشغيل المتصفح عند انقطاع
BLOCK_ASSETS=false      # حجب صور/خطوط (وفّر RAM — يقل الاستقرار)
MAX_STEPS=5000          # حد أمان للخطوات
WAIT_SHORT=150          # مهل الانتظار بالملّي ثانية
WAIT_MEDIUM=250
WAIT_AFTER_ANSWER=250
WAIT_QUIZ=600

# ── Proxy (اختياري — لحل حجب IP على Railway) ───
# بدون مصادقة:  PROXY_SERVER=http://1.2.3.4:8080
# بمصادقة:      PROXY_SERVER=http://user:pass@1.2.3.4:8080
#  أو افصلهم:
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# ── اختياري ──────────────────────────────────────
DEV_USERNAME=
DB_PATH=bot.db          # على Railway: /data/bot.db
