# ── Web service ─────────────────────────────────────
BOT_DIR=./finbot_v4_0
ANSWERS_FILE=answers.txt
DB_PATH=./finbot_v4_0/bot.db
MAX_JOBS=1
MAX_QUEUE=10
JOB_TIMEOUT_MIN=240
ALLOWED_ORIGINS=
TRUST_PROXY=1
WS_RATE_LIMIT=6
PROFILE_SLEEPS=0

# ── Bot / Playwright tuning ─────────────────────────
HEADLESS=true
MAX_STEPS=5000
RETRIES=2
BLOCK_ASSETS=false
WAIT_SHORT=150
WAIT_MEDIUM=250
WAIT_AFTER_ANSWER=250
WAIT_QUIZ=600

# اختياري: استخدمه فقط إذا كان الموقع يحتاج Proxy
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
