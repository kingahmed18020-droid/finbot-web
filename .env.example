# ── مطلوب ──
# المسار لمجلد finbot_v4_0 (اللي فيه core.py، answers.txt، إلخ)
BOT_DIR=./finbot_v4_0

# ── اختياري ──
ANSWERS_FILE=answers.txt
MAX_JOBS=2                 # عدد الجلسات الشغالة مع بعض (كل واحدة = متصفح Playwright ≈ 300-500MB رام)
MAX_QUEUE=10
JOB_TIMEOUT_MIN=240        # بقى مطبَّق فعلاً: بعد المدة دي الحل بيتوقف بحالة "timeout"
DB_PATH=./finbot_v4_0/bot.db

# ── الأمان ──
ALLOWED_ORIGINS=           # دومينات إضافية مسموحة، مثال: https://mysite.com (فاضي = نفس الدومين بس)
TRUST_PROXY=1              # 1 على Railway/Nginx عشان الـ rate limit يقرا IP الزائر الحقيقي
WS_RATE_LIMIT=6            # أقصى محاولات حل في الدقيقة لكل IP

# ── قياس السرعة ──
PROFILE_SLEEPS=0           # 1 = يطبع بعد كل حل كام ثانية ضاعت في sleep وفي أنهي سطر (شغّله مع MAX_JOBS=1)
